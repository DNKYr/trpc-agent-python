# 复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会提交）
# Telegram bot token（@BotFather）
TELEGRAM_BOT_TOKEN=

# bot 用户名（可选，用作 ChannelBinding.external_account_id）
TELEGRAM_BOT_USERNAME=

# DeepSeek 模型
MODEL_PROVIDER=deepseek
MODEL_NAME=deepseek-v4-flash
MODEL_ENDPOINT=https://api.deepseek.com
MODEL_API_KEY=

# 租户 ID（可选）
TENANT_ID=e2e
