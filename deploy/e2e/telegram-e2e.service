[Unit]
Description=Telegram E2E bot (tRPC-Agent multi-tenant)
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/trpc-agent/examples/telegram_e2e
ExecStart=/home/ubuntu/trpc-agent/.venv/bin/python main.py
Restart=always
RestartSec=5
# load_dotenv() 从 WorkingDirectory 读取 .env
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
